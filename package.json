    "dev": "next dev -p 4028",
    "build": "next build",
    "start": "next start -p 4028",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start -p 4028",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "i18n:compose": "node scripts/generate-en-messages.mjs && node scripts/compose-messages.mjs && node scripts/merge-hi-categories.mjs && node scripts/merge-indic-category-labels.mjs",
